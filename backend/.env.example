# Copy to backend/.env (or export) — never commit real secrets.
JANSAATHI_ENV=development
# SQLite for local dev; PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://jansaathi:CHANGE_ME@localhost:5432/jansaathi
DATABASE_URL=sqlite:///./jansaathi.db
# Required in production (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
SESSION_HOURS=72
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# AI assistant (optional). Without a key the assistant answers from records only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Fallbacks tried in order if the main model is not enabled for your key
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash
AI_TIMEOUT_SECONDS=25

RATE_LIMIT_CHAT_PER_MIN=12
RATE_LIMIT_AUTH_PER_MIN=10
